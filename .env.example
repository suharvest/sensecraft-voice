# ---------------------------------------------------------------------------
# SenseCraft Voice — example environment / credential template
#
# These are the credential and endpoint values referenced by
# cloud/service/config.yaml (and config-dev.yaml). Copy this file to `.env`,
# fill in real values, and keep `.env` out of version control.
# Every credential in the shipped config files is set to CHANGE_ME.
# ---------------------------------------------------------------------------

# --- Server (config: default) ----------------------------------------------
# JWT signing key used to issue/validate console + device tokens
SERVER_JWT_KEY=
# Shared key devices present during enrollment (config: enrollment_key)
SERVER_ENROLLMENT_KEY=
# Master key used to encrypt per-device secrets at rest (config: crypto_master_key)
SERVER_CRYPTO_MASTER_KEY=
# Public base URL of this backend, used to build callback/download links
SERVER_BASE_URL=https://voice-service.example.com

# --- MySQL (config: mysql) --------------------------------------------------
MYSQL_HOST=mysql.example.com
MYSQL_PORT=3306
MYSQL_USER=root
# Password for the MySQL user above (config: mysql.password)
MYSQL_PASSWORD=
MYSQL_DATABASE=sensecraft_voice

# --- MQTT broker (config: mqtt) --------------------------------------------
MQTT_SERVERS=tcp://mqtt.example.com:1883
MQTT_USERNAME=
# Password for the MQTT user above (config: mqtt.password)
MQTT_PASSWORD=

# --- Chat / LLM orchestration backend (config: chat) -----------------------
# Base URL of the Dify (or compatible) chat service
CHAT_BASE_URL=
# API key issued by that chat service (config: chat.api_key)
CHAT_API_KEY=

# --- Upstream account/API platform (config: seeed) -------------------------
# Base URL of the account/API platform the service calls out to
SEEED_BASE_URL=https://api.example.com
# Shared secret issued by that platform (config: seeed.secret_key)
SEEED_SECRET_KEY=

# --- OpenAI-compatible LLM endpoint (config: openai) -----------------------
# Base URL of the OpenAI-compatible endpoint (OpenAI, DashScope, vLLM, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
# API key for the endpoint above (config: openai.api_key)
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Object storage, MinIO / S3-compatible (config: oss.minio) -------------
OSS_MINIO_ENDPOINT=minio.example.com:9000
# Access key ID for the bucket (config: oss.minio.access_key)
OSS_MINIO_ACCESS_KEY=
# Secret access key for the bucket (config: oss.minio.secret_key)
OSS_MINIO_SECRET_KEY=
OSS_MINIO_BUCKET_NAME=sensecraft-voice
OSS_MINIO_USE_SSL=false

# --- Console frontend build (cloud/console/.env.*) -------------------------
# Backend base URL the React console talks to
VITE_API_BASE_URL=https://voice-service.example.com
